{
  // The package as Node resolves it (package "exports", self-reference):
  // ESM (.mts) and CommonJS (.cts) consumers under node16 resolution.
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": []
  },
  "files": ["esm.mts", "cjs.cts"]
}
