{
  "name": "liquid-glass-kit",
  "version": "0.1.0",
  "description": "Apple-style Liquid Glass UI kit for the web: real refraction, iOS 26 / macOS 26 components, React bindings. Works with plain HTML, Next.js, Vite, Electron and more.",
  "keywords": [
    "liquid glass",
    "glassmorphism",
    "apple",
    "ios 26",
    "macos",
    "ui kit",
    "css",
    "react",
    "nextjs",
    "electron",
    "components",
    "backdrop-filter"
  ],
  "license": "MIT",
  "author": "noexgeci",
  "homepage": "https://github.com/noexgeci/liquid-glass-and-more-apple",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noexgeci/liquid-glass-and-more-apple.git"
  },
  "bugs": "https://github.com/noexgeci/liquid-glass-and-more-apple/issues",
  "type": "module",
  "main": "./dist/liquid-glass.cjs",
  "module": "./dist/liquid-glass.mjs",
  "types": "./dist/index.d.ts",
  "style": "./dist/liquid-glass.css",
  "unpkg": "./dist/liquid-glass.min.js",
  "jsdelivr": "./dist/liquid-glass.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/liquid-glass.mjs",
      "require": "./dist/liquid-glass.cjs"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.mjs",
      "require": "./dist/auto.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.mjs",
      "require": "./dist/react.cjs"
    },
    "./css": "./dist/liquid-glass.css",
    "./min.css": "./dist/liquid-glass.min.css",
    "./liquid-glass.css": "./dist/liquid-glass.css",
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "*.css",
    "./dist/auto.mjs",
    "./dist/auto.cjs",
    "./dist/liquid-glass.js",
    "./dist/liquid-glass.min.js"
  ],
  "files": [
    "dist",
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "serve": "npx --yes serve -l 3000 .",
    "test": "node scripts/build.mjs && node tests/smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
